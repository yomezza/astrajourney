# Documentation only: the executable reads process environment, not this file.
# Optional alternative: CONFIG_FILE selects a TOML file exclusively.
# When set, the application settings below are ignored; missing TOML values use
# built-in defaults, not the environment. See configs/*.example.toml.
# CONFIG_FILE=C:\Cosmosimulator\configs\cosmos.toml
DATABASE_URL=postgres://cosmos:CHANGE_ME@127.0.0.1:5432/cosmosimulator?sslmode=disable
# Optional: use a dedicated schema in the existing database; default is public.
DB_SCHEMA=cosmosimulator
HTTP_ADDR=127.0.0.1:8080
# Set both only to bootstrap a new admin. No default credentials.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
# For HTTPS reverse proxy deployments:
# PUBLIC_ORIGIN=https://game.example.com
# COOKIE_SECURE=true

# Trust only the actual reverse proxy networks, never arbitrary client headers.
# The proxy must set/append the real client address in X-Forwarded-For.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Planetary service foundation (separate process, same database/schema).
# Run the matching cosmic version first; planet never runs migrations.
# Prefer a separate DATABASE_URL login with the restricted grants in docs.
# PLANET_HTTP_ADDR=127.0.0.1:8081
# Defaults: PUBLIC_ORIGIN if set, otherwise http://127.0.0.1:8080,http://localhost:8080
# PLANET_ALLOWED_ORIGINS=https://game.example.com
# Optional append-only JSON log; directory must already exist and be writable.
# PLANET_LOG_FILE=C:\Cosmosimulator\logs\planet.log
# PLANET_DB_TIMEOUT=2s
# PLANET_LEASE_TTL=15s
# PLANET_LEASE_RENEW=5s
# PLANET_SHUTDOWN_TIMEOUT=10s
# P2-3: immutable sector cache, loaded on demand, never a full-planet preload.
# PLANET_SCENE_CAPACITY=32
# PLANET_SCENE_IDLE_TTL=2m
# PLANET_SCENE_LOAD_TIMEOUT=20s
# Lease renewal must be >=1s and <=TTL/3; DB timeout must be below renewal.
# Multiplayer presence, confirmed cross-sector transitions and lazy art are available.

# P2-4: cosmic-owned same-origin gateway; enable only after both services upgrade.
# PLANET_ENABLED=true
# PLANET_INTERNAL_URL=http://127.0.0.1:8081
# Set PUBLIC_ORIGIN/PLANET_ALLOWED_ORIGINS to the exact browser origin.

# P2-5: planetary process only; default speed is 4 world units/second.
# PLANET_MOVE_SPEED=4
# PLANET_PATH_BUDGET=24000

# Aggregate diagnostics (requires a live administrator session, never public):
# GET /api/admin/metrics and GET /planet/api/v1/metrics
# Restricted planet logins additionally need SELECT(role) on the users table.
# Pool size can be set in each DATABASE_URL query, e.g. &pool_max_conns=8.
# The 50-client process load experiment runs only in an owned *_test database;
# RUN_PLANET_LOAD is a test-runner switch, not a service setting.

# Chat: migrate with Cosmic first; runtime is a separate third Windows service.
# CHAT_ENABLED=true
# CHAT_INTERNAL_URL=http://127.0.0.1:8082
# CHAT_DATABASE_URL=postgres://chat_runtime:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
# CHAT_HTTP_ADDR=127.0.0.1:8082
# COSMIC_INTERNAL_URL=http://127.0.0.1:8080
# CHAT_ALLOWED_ORIGINS=https://game.example.com
# Chat 0.24.8: legacy (default), a1 (local), a2 (PostgreSQL LISTEN).
# A2: isolated tests only until separately approved DBA trigger rollout; no NATS.
# CHAT_DISPATCHER_MODE=legacy
# CHAT_FALLBACK_POLL_INTERVAL=10s
# CHAT_DEGRADED_POLL_INTERVAL=2s
# CHAT_OUTBOX_OVERLAP=60s
# Required independent durable erasure journal; directory must already exist.
# CHAT_ERASURE_JOURNAL=C:\Cosmosimulator\data\chat-erasure.log
# Run --maintain daily with a separate partition-owner connection, or configure:
# CHAT_MAINTENANCE_DATABASE_URL=postgres://partition_owner:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
# See docs/chat-service/README.ru.md for grants, SCM and backup recovery.
