            "cosmos.v1.signal.cosmic.company.permissions.changed",
            "cosmos.v1.signal.cosmic.moderator.changed",
            "cosmos.v1.signal.cosmic.company.deletion.requested",
            "cosmos.v1.signal.cosmic.transfer.return.completed",
            "cosmos.v1.signal.planet.visit.started",
            "cosmos.v1.signal.planet.visit.resumed",
            "cosmos.v1.signal.planet.sector.changed",
            "cosmos.v1.signal.planet.visit.disconnected",
            "cosmos.v1.signal.planet.visit.ended",
            "cosmos.v1.signal.planet.presence.stale",
