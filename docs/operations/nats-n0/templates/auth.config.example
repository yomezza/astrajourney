authorization {
  "timeout": 5,
  "users": [
    {
      "user": "cosmos",
      "password": "<BCRYPT_HASH_COSMOS>",
      "permissions": {
        "publish": {
          "allow": [
            "cosmos.v1.signal.cosmic.company.membership.changed",
            "cosmos.v1.signal.cosmic.company.role.changed",
            "cosmos.v1.signal.cosmic.company.permissions.changed",
