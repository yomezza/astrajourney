            "cosmos.v1.signal.planet.visit.disconnected",
            "cosmos.v1.signal.planet.visit.ended",
            "cosmos.v1.signal.planet.presence.stale"
          ]
        },
        "subscribe": {
          "deny": [
            ">"
          ]
        }
