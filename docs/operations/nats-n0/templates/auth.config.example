    {
      "user": "chat",
      "password": "<BCRYPT_HASH_CHAT>",
      "permissions": {
        "publish": {
          "allow": [
            "cosmos.v1.signal.chat.outbox.changed",
            "cosmos.v1.signal.chat.company.cleanup.completed"
          ]
        },
        "subscribe": {
          "allow": [
            "cosmos.v1.signal.cosmic.company.membership.changed",
