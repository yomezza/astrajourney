[Unit]
Description=Astra Journey CDN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astrajourney
Group=astrajourney
StateDirectory=astra-journey/cdn
StateDirectoryMode=0700
WorkingDirectory=/var/lib/astra-journey/cdn
Environment=CONFIG_FILE=/etc/astra-journey/shared.toml
ExecStart=/opt/astra-journey/bin/astra-journey-cdn
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
